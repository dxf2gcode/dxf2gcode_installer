#
# Simple Makefile to pack common tasks into one standard interface
#

.DEFAULT_GOAL := prepare

PYTHON ?= python3
PYQT_VERSION = $(shell $(PYTHON) -c "from dxf2gcode.presentation.qt.qt_compat import PYQT_VERSION; print(PYQT_VERSION)")
BUILD_TOOLS = tools/build

# Translation files
SRC_TS = $(wildcard i18n/*.ts)
OBJ_TS = $(patsubst %.ts,%.qm,$(SRC_TS))

# UI files
SRC_UI = dxf2gcode/presentation/qt/resources/dxf2gcode_images.qrc dxf2gcode/presentation/qt/resources/dxf2gcode.ui
OBJ_UI = dxf2gcode/presentation/qt/generated/dxf2gcode_images$(PYQT_VERSION)_rc.py dxf2gcode/presentation/qt/generated/dxf2gcode_ui$(PYQT_VERSION).py

#
# Prepare everything needed for dxf2gcode to run
#
.PHONY: prepare
prepare: $(OBJ_TS) $(OBJ_UI)

# Release archives contain prepared assets for both supported Qt bindings.
# Qt 6 rcc and Qt Linguist lrelease must be available on PATH.
.PHONY: prepare-release package windows
prepare-release:
	DXF2GCODE_QT=5 $(PYTHON) $(BUILD_TOOLS)/qt_assets.py
	DXF2GCODE_QT=6 $(PYTHON) $(BUILD_TOOLS)/qt_assets.py
	DXF2GCODE_QT=5 $(PYTHON) $(BUILD_TOOLS)/translations.py --no-pylupdate

package: prepare-release
	$(PYTHON) -m build

windows: prepare-release
	$(PYTHON) $(BUILD_TOOLS)/windows.py bdist_msi

.NOTPARALLEL: $(OBJ_TS)
$(OBJ_TS): $(SRC_TS) $(BUILD_TOOLS)/translations.py
	$(PYTHON) $(BUILD_TOOLS)/translations.py --no-pylupdate

.NOTPARALLEL: $(OBJ_UI)
$(OBJ_UI): $(SRC_UI) $(BUILD_TOOLS)/qt_assets.py
	$(PYTHON) $(BUILD_TOOLS)/qt_assets.py

#
# Remove autogenerated files
#
.PHONY: clean
clean:
	rm -f $(OBJ_TS) $(OBJ_UI)
	find . -type d -name __pycache__ -print0 | xargs -0 rm -rf

#
# Prepare for translation with 'linguist' (trs = TRanslation Start).
# Don't forget to run 'make trf' afterwards to remove <location> tags from ts files
# (trf = TRanslation Finish)
#
.PHONY: trs
trs:
	$(PYTHON) $(BUILD_TOOLS)/translations.py --keep-ln
	@echo ""
	@echo ">>> Translation files prepared for work."
	@echo ">>> Don't forget to run 'make trf' after you finish translating."

.PHONY: trf
trf:
	$(PYTHON) $(BUILD_TOOLS)/translations.py
	@echo ""
	@echo ">>> Translation files are ready for commiting into repository."
